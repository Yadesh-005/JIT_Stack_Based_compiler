; DIV_INT is supported by the interpreter but deliberately not by the JIT.
; Expected: recording aborts ("not supported"), loop blacklisted, result correct.
; sum_{i<50} i/3 = 392
      LOAD_CONST R0, 0
      LOAD_CONST R1, 1
      LOAD_CONST R2, 50
      LOAD_CONST R3, 0
      LOAD_CONST R4, 3
loop: DIV_INT    R5, R0, R4
      ADD_INT    R3, R3, R5
      ADD_INT    R0, R0, R1
      JUMP_IF_LT R0, R2, loop
      PRINT_REG  R3
      HALT
