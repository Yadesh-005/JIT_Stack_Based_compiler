; if/else inside a loop: the trace follows one path and the other path is
; reached through a side exit (deoptimisation) every other iteration.
; evens sum (0..98) = 2450, odd count = 50
      LOAD_CONST R0, 0      ; i
      LOAD_CONST R1, 1
      LOAD_CONST R2, 100    ; n
      LOAD_CONST R3, 0      ; sum of even i
      LOAD_CONST R4, 0      ; number of odd i
      LOAD_CONST R6, 0
loop: AND_INT    R5, R0, R1
      JUMP_IF_EQ R5, R6, even
      ADD_INT    R4, R4, R1
      JUMP       next
even: ADD_INT    R3, R3, R0
next: ADD_INT    R0, R0, R1
      JUMP_IF_LT R0, R2, loop
      PRINT_REG  R3
      PRINT_REG  R4
      HALT
