; The same bounds check appears twice per iteration (as safe code often does).
; The second guard is removed by guard elimination. sum 0..99 = 4950
      LOAD_CONST R0, 0
      LOAD_CONST R1, 1
      LOAD_CONST R2, 100
      LOAD_CONST R3, 0
      LOAD_CONST R9, 1000      ; capacity
loop: JUMP_IF_LT R0, R9, ok1
      HALT
ok1:  JUMP_IF_LT R0, R9, ok2
      HALT
ok2:  ADD_INT    R3, R3, R0
      ADD_INT    R0, R0, R1
      JUMP_IF_LT R0, R2, loop
      PRINT_REG  R3
      HALT
