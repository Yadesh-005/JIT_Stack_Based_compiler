; B7: data-dependent branch alternating every iteration (worst case for a
; single linear trace: side exit on every other iteration)
      LOAD_CONST R0, 0
      LOAD_CONST R1, 1
      LOAD_CONST R2, 10000000
      LOAD_CONST R3, 0
      LOAD_CONST R4, 0
      LOAD_CONST R6, 0
loop: AND_INT    R5, R0, R1
      JUMP_IF_EQ R5, R6, even
      ADD_INT    R4, R4, R0
      JUMP       next
even: ADD_INT    R3, R3, R0
next: ADD_INT    R0, R0, R1
      JUMP_IF_LT R0, R2, loop
      PRINT_REG  R3
      PRINT_REG  R4
      HALT
