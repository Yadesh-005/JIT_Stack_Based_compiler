; B6: loop with repeated bounds checks (redundant-guard elimination)
      LOAD_CONST R0, 0
      LOAD_CONST R1, 1
      LOAD_CONST R2, 20000000
      LOAD_CONST R3, 0
      LOAD_CONST R9, 2000000000
loop: JUMP_IF_LT R0, R9, ok1
      HALT
ok1:  ADD_INT    R3, R3, R0
      JUMP_IF_LT R0, R9, ok2
      HALT
ok2:  ADD_INT    R3, R3, R1
      JUMP_IF_LT R0, R9, ok3
      HALT
ok3:  ADD_INT    R0, R0, R1
      JUMP_IF_LT R0, R2, loop
      PRINT_REG  R3
      HALT
